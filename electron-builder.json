{
  "appId": "com.valisepremiere.app",
  "productName": "TransPorter",
  "directories": {
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "package.json",
    "CHANGELOG.md"
  ],
  "asarUnpack": [
    "src/renderer/assets/sounds/**",
    "src/renderer/assets/GIF/**",
    "src/renderer/assets/loading/**",
    "src/renderer/assets/upload/**"
  ],
  "mac": {
    "icon": "build/icon.icns",
    "target": ["dmg", "zip"],
    "category": "public.app-category.video"
  }
}


